# Copy this file to .env (which is git-ignored) and fill in your key, or export
# the variable in your shell. Request a key by emailing api@c-spanarchives.org.
#
# Note: the client reads the environment variable directly; it does not load
# .env files itself. Use `export $(cat .env)` or a tool like python-dotenv.
CSPAN_API_KEY=your-api-key-here
